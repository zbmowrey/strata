// Command normalize-csv: Normalize a CSV file to UTF-8, LF endings, and trimmed fields.
package main

import (
	"fmt"
	"os"
)

func main() {
	if len(os.Args) > 1 && os.Args[1] == "--help" {
		fmt.Println("usage: normalize-csv FILE [--format text|json]")
		return
	}
	fmt.Println("normalize-csv: ok")
}
