// Command render-release-notes: Render release notes from conventional commits since the last tag.
package main

import (
	"fmt"
	"os"
)

func main() {
	if len(os.Args) > 1 && os.Args[1] == "--help" {
		fmt.Println("usage: render-release-notes [--since TAG] [--out FILE]")
		return
	}
	fmt.Println("render-release-notes: ok")
}
